rules_version = '2';
// Cada usuario solo puede leer/escribir su propio árbol:
//   usuarios/{uid}/{coleccion}/{docId}
// Todo lo demás queda cerrado por defecto.
// Si después hay empleados con roles (ej. solo capturar órdenes),
// agregar aquí una función puede(rol) Y USARLA en cada match
// (lección de NEXORA: la función existía pero nunca se llamaba).
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{coleccion}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && coleccion in ['clientes', 'ordenes', 'cotizaciones', 'gastos', 'servicios', 'ajustes'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
