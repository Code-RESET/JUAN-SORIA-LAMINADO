{
  "name": "juan-soria-laminado",
  "private": true,
  "type": "module",
  "description": "La app NO necesita npm para correr. Este archivo es solo para las pruebas automáticas.",
  "scripts": {
    "test": "node --test tests/unit.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-juan-soria \"node --test tests/firestore.rules.test.js\"",
    "test:all": "npm test && npm run test:e2e && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "playwright": "^1.47.0"
  }
}
